# ==========================================
# 大六壬赛博终端 V2.0 - 万能大模型驱动核心
# ==========================================
# 【使用必读】：
# 1. 默认开启的是【DeepSeek】配置。
# 2. 如果你想换别的模型，只需把你不想用的模型前面加上 # 号（变成注释）。
# 3. 然后把你“想用”的模型前面的 # 号删掉。
# 4. 最后把 YOUR_API_KEY_HERE 换成你真实的 API 密钥即可！

# ------------------------------------------
# 🔴 【选项 1】DeepSeek (深度求索) - 默认推荐
# ------------------------------------------
OPENAI_API_KEY=YOUR_API_KEY_HERE
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-v4-pro

# 1. 逻辑严谨度 / 幻觉控制阀 (0.0 到 2.0 之间)
# 默认 0.01：极度严谨，适合玄学推演，拒绝 AI 幻觉和胡编乱造。
# 如果你想让判词更有文采、更发散，可以调高到 0.6 甚至 0.8。
OPENAI_TEMPERATURE=0.01

# 2. 神谕最大输出字数限制 (Token 数量)
# 默认 4000。如果发现长篇推演时话没说完就被强制掐断，可以尝试调高至 8000。
OPENAI_MAX_TOKENS=8000





# ------------------------------------------
# 🟠 【选项 2】通义千问 (阿里云 Qwen)
# ------------------------------------------
# OPENAI_API_KEY=YOUR_API_KEY_HERE
# OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# OPENAI_MODEL=qwen-max
# OPENAI_TEMPERATURE=0.01
# OPENAI_MAX_TOKENS=4000
# ------------------------------------------
# 🟡 【选项 3】Kimi (月之暗面)
# ------------------------------------------
# OPENAI_API_KEY=YOUR_API_KEY_HERE
# OPENAI_BASE_URL=https://api.moonshot.cn/v1
# OPENAI_MODEL=moonshot-v1-8k
# OPENAI_TEMPERATURE=0.01
# OPENAI_MAX_TOKENS=4000

# ------------------------------------------
# 🟢 【选项 4】智谱清言 (GLM-4)
# ------------------------------------------
# OPENAI_API_KEY=YOUR_API_KEY_HERE
# OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
# OPENAI_MODEL=glm-4
# OPENAI_TEMPERATURE=0.01
# OPENAI_MAX_TOKENS=4000

# ------------------------------------------
# 🔵 【选项 5】OpenAI 官方 (ChatGPT)
# ------------------------------------------
# OPENAI_API_KEY=YOUR_API_KEY_HERE
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o
# OPENAI_TEMPERATURE=0.01
# OPENAI_MAX_TOKENS=4000